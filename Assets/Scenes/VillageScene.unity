  m_Script: {fileID: 11500000, guid: cc85189f3afc52c40a520a281221ac3b, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::RoundHouseInteraction
  title: Ume Kbubu
  body: 'Ume kbubu adalah rumah bulat warga desa. Dindingnya dari batu dan tanah liat, atapnya dari alang-alang yang tebal.


    Rumah ini hampir tanpa jendela. Asap tungku di tengah ruangan menghangatkan badan dan membuat atap lebih awet.


    Di dalamnya keluarga berkumpul, menyimpan jagung, dan menerima tamu. Pintunya rendah agar setiap orang masuk dengan menunduk.'
  promptText: Tekan E / Baca untuk masuk
  interiorSceneName: RoundHouseInterior
  interiorReady: 1
  spotIndex: 0
