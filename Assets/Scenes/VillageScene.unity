  m_Script: {fileID: 11500000, guid: cc85189f3afc52c40a520a281221ac3b, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::RoundHouseInteraction
  title: Kebun & Pangan
  body: 'Warga menanam jagung, ubi kayu, kacang, dan sayur di kebun dekat rumah. Ada juga pisang dan buah-buahan di pekarangan.


    Tanaman ditanam berselang-seling supaya tanah tidak cepat habis dan serangga pengganggu berkurang.


    Hasil kebun dimakan sendiri, dijual ke pasar, atau disimpan untuk musim kering. Sisa daun dan batang dijadikan pakan ternak.'
  promptText: Tekan E / Baca untuk masuk
  interiorSceneName: RoundHouseInterior
  interiorReady: 1
  spotIndex: 2
